# ─────────────────────────────────────────────────────────────
# Overseer OS — environment configuration
# Copy to `.env.local` and fill in real values for local dev.
# ─────────────────────────────────────────────────────────────

# Supabase (database, auth, storage, realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI intelligence layer (Anthropic Claude)
ANTHROPIC_API_KEY=
# Default model for the Overseer intelligence layer.
OVERSEER_AI_MODEL=claude-opus-4-8

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
